# Читает не приложение, а docker-compose и sync.sh. Настройки прокси — в config.yaml.

# каталог с сертификатом на хосте; монтируется в контейнер как /certs,
# пути к файлам задаются в config.yaml
CERT_DIR=/root/cert/ip

# ssh-хост и каталог проекта на сервере
GPROXY_REMOTE=myserver:~/gemini-proxy-docker/

# тег образа CLIProxyAPI
# CP_VERSION=latest
