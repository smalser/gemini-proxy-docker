# Всё, кроме секции деплоя, читает сам gemini-balance — полный список переменных
# в его README. Списки задаются JSON-массивом, не через запятую.

# ── ключи ────────────────────────────────────────────────────────────────
# пул гугловых ключей, между которыми крутится нагрузка
API_KEYS=["AIzaSy...","AIzaSy..."]
# ключи для клиентов: их вписывают агенты как api_key
ALLOWED_TOKENS=["sk-своя-строка"]
# вход в веб-морду
AUTH_TOKEN=sk-своя-строка

# ── база ─────────────────────────────────────────────────────────────────
DATABASE_TYPE=sqlite
SQLITE_DATABASE=default_db

# ── исходящий прокси ─────────────────────────────────────────────────────
# пустой список — Google зовётся напрямую; поддерживаются http и socks5
PROXIES=["http://user:pass@host:port"]

TIMEZONE=Europe/Moscow

# ── TLS и деплой: это читает не приложение, а caddy и sync.sh ─────────────
# домен или IP, на который выписан сертификат
DOMAIN=203.0.113.10
# каталог с сертификатом на хосте; внутри должны лежать cert.pem и key.pem
CERT_DIR=/root/cert/ip
# если файлы названы иначе — пути внутри контейнера (каталог смонтирован как /certs)
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

# ssh-хост и каталог проекта на сервере
GPROXY_REMOTE=myserver:~/gemini-proxy-docker/
# тег образа gemini-balance
# GB_VERSION=latest
