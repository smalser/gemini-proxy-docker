# used by docker-compose (build args + runtime env)

# коммит/тег/ветка upstream-репозитория lehuygiang28/gemini-proxy, который собираем
# UPSTREAM_REF=main

# куда деплоит sync.sh: ssh-хост и каталог проекта на сервере
GPROXY_REMOTE=myserver:~/gemini-proxy-docker/

# домен, на который выписан сертификат
DOMAIN=gemini.example.com
# каталог с сертификатом на хосте; внутри должны лежать cert.pem и key.pem
CERT_DIR=./certs
# если файлы названы иначе — пути внутри контейнера (каталог смонтирован как /certs)
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_ANON_SUPABASE_KEY=sb_publishable_...
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# исходящие запросы (Google API, Supabase) через HTTP(S)-прокси; пусто = напрямую
# HTTPS_PROXY=http://user:pass@proxy-host:3128
# HTTP_PROXY=http://user:pass@proxy-host:3128
# NO_PROXY=localhost,127.0.0.1
